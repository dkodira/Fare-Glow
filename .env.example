# Add these after creating a Supabase project to enable real accounts and saved searches.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SerpApi flight searches (keep the key private; server-side only).
SERPAPI_KEY_MODE=owner
SERPAPI_API_KEY=
# Leave a safety reserve within SerpApi's 250-search free allowance.
# The app caps this value at 200.
SERPAPI_MONTHLY_BUDGET=200

# For a second, bring-your-own-key deployment, set both mode values to "byok".
NEXT_PUBLIC_SERPAPI_KEY_MODE=owner
# BYOK mode requires these server-only secrets and the user_serpapi_keys table.
SUPABASE_SERVICE_ROLE_KEY=
FARE_GLOW_ENCRYPTION_KEY=
